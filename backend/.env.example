# Copy this to .env and fill in values

# Required — get your free key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Required — from your Supabase project settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Optional — if set, all endpoints require this in the x-api-key header
# Set to the same value as VITE_API_KEY in your frontend .env
API_KEY=

# Optional — HTTP timeouts in seconds (defaults shown)
SUPABASE_TIMEOUT=5.0
GROQ_TIMEOUT=30.0

# Required in production — comma-separated list of allowed frontend origins
# Set to your Vercel deployment URL; leave empty to block all cross-origin requests
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=
