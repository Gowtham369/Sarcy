# Copy this to .env and fill in values

# Required — get your free key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Required — from your Supabase project settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Optional — if set, all endpoints require this in the x-api-key header
# Set to the same value as VITE_API_KEY in your frontend .env
API_KEY=

# Optional — comma-separated list of allowed frontend origins
# Use * to allow all (development only); set your Vercel URL in production
# Example: https://your-app.vercel.app
ALLOWED_ORIGINS=*
